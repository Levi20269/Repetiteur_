rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.level == 1
        && request.resource.data.xp == 0;
      allow read: if request.auth != null && request.auth.uid == userId;
      // Les champs sensibles sont gérés exclusivement par les Cloud Functions.
      allow update, delete: if false;
    }

    match /subjects/{subjectId} { allow read: if request.auth != null; allow write: if false; }
    match /exercises/{exerciseId} { allow read: if request.auth != null; allow write: if false; }

    match /progress/{progressId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Les réponses passent par l'API : l'élève ne peut pas choisir son score.
      allow create, update, delete: if false;
    }
  }
}
